# Environment
.env
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Hypothesis property-based test cache
.hypothesis/

# Data cache (regenerated from API; never commit raw API responses)
data/raw/
# Ignore the directory's contents (not the directory itself) so that the
# negations below can re-include specific files.
data/processed/*

# Exception: user-maintained reference data committed intentionally
!data/processed/pgr_edgar_cache.csv
!data/processed/pgr_combined_ratio_manual.csv
!data/processed/pgr_valuation_monthly.csv

# Personal financial data — never commit
data/processed/position_lots.csv

# API keys
alphavantage-api-key.txt
fmp-api-key.txt
fred-api-key.txt

# v2 SQLite database — committed to repo so GitHub Actions can accumulate data
# over time and push daily updates back to the branch.
!data/pgr_financials.db
# SQLite WAL sidecars created by read-write connections; never commit them.
*.db-wal
*.db-shm
*.db-journal

# Plot output
plots/

# Output of `--dry-run` production entry points (never committed)
results/dry_run/

# Research per-fold detail files over 1 MB: regenerate them with the study
# script (see the study README); never commit them (review 2026-09-25, phase 3).
research/studies/*/outputs/detail/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Claude Code local config
.claude/

# Archives
*.zip

# Git worktree scratch directories (created by Claude Code agent isolation)
.clone/
